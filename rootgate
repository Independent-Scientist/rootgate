#!/usr/bin/env python3
# rootgate — agent-agnostic broker for privileged actions.
#
# Any process can *ask*; only a human can *approve*; root executes the exact
# bytes that were approved. The approval secret travels on a channel the agent
# cannot read (console, ntfy topic, or a file the test harness owns) — never
# through the requesting process.
#
# SPDX-License-Identifier: MIT
import argparse
import base64
import hashlib
import hmac
import http.server
import json
import os
import secrets
import shutil
import socket
import socketserver
import struct
import subprocess
import sys
import threading
import time
import urllib.parse
import urllib.request

VERSION = "0.1"
DEFAULTS = {
    "socket": "/run/rootgate/rootgate.sock",
    "state": "/var/lib/rootgate",
    "log": "/var/log/rootgate.log",
    "secrets": "/etc/rootgate/secrets",
    "http_port": "8733",
    "public_base": "",          # e.g. https://abc.ngrok-free.app
    "ttl": "600",
    "notify": "console",        # console | file | ntfy
    "notify_file": "",          # for notify=file (test harness)
    "ntfy_url": "https://ntfy.sh",
    "ntfy_topic": "",
    "socket_mode": "0666",       # see README: any local user may *ask*; approval is separate
    "max_pending": "3",
    "min_interval": "5",
    "exec_timeout": "900",
}


# ---------------------------------------------------------------- config
def load_config():
    cfg = dict(DEFAULTS)
    path = os.environ.get("ROOTGATE_CONFIG", "/etc/rootgate/config.json")
    if os.path.exists(path):
        with open(path) as fh:
            cfg.update(json.load(fh))
    for k, v in os.environ.items():
        if k.startswith("ROOTGATE_"):
            key = k[len("ROOTGATE_"):].lower()
            if key in cfg:
                cfg[key] = v
    return cfg


# ---------------------------------------------------------------- helpers
def now():
    return int(time.time())


def req_dir(cfg, rid):
    return os.path.join(cfg["state"], "requests", rid)


def read_meta(cfg, rid):
    p = os.path.join(req_dir(cfg, rid), "meta.json")
    if not os.path.exists(p):
        return None
    with open(p) as fh:
        return json.load(fh)


def write_meta(cfg, rid, meta):
    p = os.path.join(req_dir(cfg, rid), "meta.json")
    tmp = p + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(meta, fh, indent=1, sort_keys=True)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, p)


def audit(cfg, event, **kw):
    rec = {"ts": now(), "event": event}
    rec.update(kw)
    line = json.dumps(rec, sort_keys=True)
    with open(cfg["log"], "a") as fh:
        fh.write(line + "\n")
        fh.flush()


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def payload_sha(cfg, rid):
    return sha256_file(os.path.join(req_dir(cfg, rid), "payload.sh"))


def notify(cfg, rid, meta, token):
    base = cfg["public_base"] or f"http://127.0.0.1:{cfg['http_port']}"
    url = f"{base}/a/{token}"
    head = (f"rootgate: approval needed\n"
            f"  id      {rid}\n"
            f"  from    {meta['agent']} (uid {meta['submitter']['uid']})\n"
            f"  what    {meta['desc']}\n"
            f"  sha256  {meta['sha256']}\n"
            f"  expires in {int(cfg['ttl'])}s\n")
    if cfg["notify"] == "console":
        msg = head + f"  open    {url}\n"
        try:
            with open("/dev/console", "w") as fh:
                fh.write("\n" + msg + "\n")
        except OSError:
            pass
        subprocess.run(["logger", "-t", "rootgate", msg], check=False)
        return
    if cfg["notify"] == "file":
        with open(cfg["notify_file"], "a") as fh:
            fh.write(json.dumps({"id": rid, "url": url, "token": token,
                                 "sha256": meta["sha256"], "desc": meta["desc"]}) + "\n")
        return
    if cfg["notify"] == "ntfy":
        topic = cfg["ntfy_topic"]
        if not topic:
            raise RuntimeError("notify=ntfy but ntfy_topic is empty")
        body = head.encode()
        req = urllib.request.Request(
            f"{cfg['ntfy_url']}/{topic}",
            data=body,
            headers={"Title": "rootgate approval needed",
                     "Priority": "high",
                     "Tags": "rotating_light",
                     "Actions": f"view, Approve/deny, {url}, clear=true"},
            method="POST")
        urllib.request.urlopen(req, timeout=10).read()
        return
    if cfg["notify"] == "telegram":
        # Credentials live in the secrets file (root-only), so no agent can read
        # them and no agent can deliver or intercept the approval link.
        secrets = read_secrets(cfg)
        tok = secrets.get("TELEGRAM_BOT_TOKEN")
        chat = secrets.get("TELEGRAM_CHAT_ID")
        if not tok or not chat:
            raise RuntimeError("notify=telegram needs TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID")
        text = head + f"\nApproval: {url}"
        req = urllib.request.Request(
            f"https://api.telegram.org/bot{tok}/sendMessage",
            data=json.dumps({
                "chat_id": chat,
                "text": text,
                "disable_web_page_preview": True,
                "reply_markup": {"inline_keyboard": [[
                    {"text": "Review and approve", "url": url}]]},
            }).encode(),
            headers={"Content-Type": "application/json"},
            method="POST")
        urllib.request.urlopen(req, timeout=15).read()
        return
    raise RuntimeError(f"unknown notify backend {cfg['notify']}")


def read_secrets(cfg):
    out = {}
    path = cfg["secrets"]
    if os.path.exists(path):
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                out[k.strip()] = v.strip()
    return out


# ---------------------------------------------------------------- execution
def execute(cfg, rid):
    meta = read_meta(cfg, rid)
    if meta is None:
        return
    payload = os.path.join(req_dir(cfg, rid), "payload.sh")
    current = payload_sha(cfg, rid)
    if current != meta["sha256"]:
        meta["state"] = "refused"
        meta["error"] = f"payload changed: {meta['sha256']} -> {current}"
        write_meta(cfg, rid, meta)
        audit(cfg, "execution_refused", id=rid, reason=meta["error"])
        return

    meta["state"] = "running"
    meta["started"] = now()
    write_meta(cfg, rid, meta)
    audit(cfg, "execution_start", id=rid, sha256=current, agent=meta["agent"])

    log_path = os.path.join(req_dir(cfg, rid), "run.log")
    timeout = int(cfg["exec_timeout"])
    try:
        if os.geteuid() == 0:
            cmd = ["systemd-run", "--unit", f"rootgate-{rid}", "--collect",
                   "--pipe", "--wait", "--quiet",
                   "/bin/bash", payload]
        else:                       # test mode: no privilege, no systemd
            cmd = ["/bin/bash", payload]
        with open(log_path, "wb") as out:
            proc = subprocess.run(cmd, stdout=out, stderr=subprocess.STDOUT,
                                  cwd="/", timeout=timeout,
                                  env={"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
                                       "HOME": "/root", "TERM": "dumb"})
        rc = proc.returncode
        state = "done" if rc == 0 else "failed"
    except subprocess.TimeoutExpired:
        rc = 124
        state = "failed"
        with open(log_path, "ab") as out:
            out.write(b"\nrootgate: execution timed out\n")
    meta = read_meta(cfg, rid)
    meta["state"] = state
    meta["exit_code"] = rc
    meta["ended"] = now()
    write_meta(cfg, rid, meta)
    audit(cfg, "execution_end", id=rid, rc=rc, state=state)


# ---------------------------------------------------------------- server
class Handler(socketserver.StreamRequestHandler):
    def handle(self):
        creds = self.request.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                        struct.calcsize("3i"))
        _pid, uid, _gid = struct.unpack("3i", creds)
        line = self.rfile.readline(1 << 20)
        if not line:
            return
        try:
            req = json.loads(line)
        except ValueError:
            self.reply({"ok": False, "error": "bad json"})
            return
        try:
            resp = self.dispatch(req, uid)
        except Exception as exc:                     # noqa: BLE001
            resp = {"ok": False, "error": f"{type(exc).__name__}: {exc}"}
        self.reply(resp)

    def reply(self, obj):
        self.wfile.write((json.dumps(obj) + "\n").encode())
        self.wfile.flush()

    # --- operations -----------------------------------------------------
    def dispatch(self, req, uid):
        cfg = self.server.cfg
        op = req.get("op")
        if op == "ping":
            return {"ok": True, "version": VERSION, "euid": os.geteuid()}

        if op == "submit":
            return self.op_submit(cfg, req, uid)
        if op == "status":
            meta = read_meta(cfg, req.get("id", ""))
            if not meta:
                return {"ok": False, "error": "no such request"}
            return {"ok": True, "meta": public_meta(cfg, meta)}
        if op == "list":
            return {"ok": True, "requests": self.op_list(cfg)}
        if op == "log":
            rid = req.get("id", "")
            p = os.path.join(req_dir(cfg, rid), "run.log")
            if not os.path.exists(p):
                return {"ok": True, "log": ""}
            with open(p, "rb") as fh:
                return {"ok": True, "log": fh.read().decode("utf-8", "replace")}
        if op == "approve":
            return self.op_decide(cfg, req, uid, approve=True)
        if op == "deny":
            return self.op_decide(cfg, req, uid, approve=False)
        if op == "wait":
            deadline = now() + int(req.get("timeout", 120))
            rid = req.get("id", "")
            while now() < deadline:
                meta = read_meta(cfg, rid)
                if not meta:
                    return {"ok": False, "error": "no such request"}
                if meta["state"] in ("done", "failed", "denied", "expired", "refused", "cancelled"):
                    return {"ok": True, "meta": public_meta(cfg, meta)}
                time.sleep(0.5)
            meta = read_meta(cfg, rid)
            return {"ok": True, "meta": public_meta(cfg, meta)}
        return {"ok": False, "error": f"unknown op {op}"}

    def op_submit(self, cfg, req, uid):
        script = req.get("script")
        if not script:
            return {"ok": False, "error": "empty payload"}
        raw = base64.b64decode(script)
        if len(raw) > 256 * 1024:
            return {"ok": False, "error": "payload too large"}

        # rate limits, so one run-away agent cannot flood a human with prompts
        pend = [m for m in self.all_metas(cfg)
                if m["state"] == "pending" and m["submitter"]["uid"] == uid]
        if len(pend) >= int(cfg["max_pending"]):
            return {"ok": False, "error": "too many pending requests for this uid"}
        recent = [m for m in self.all_metas(cfg) if m["submitter"]["uid"] == uid]
        if recent:
            last = max(m["created"] for m in recent)
            if now() - last < int(cfg["min_interval"]):
                return {"ok": False, "error": "submitted too recently; wait a moment"}

        rid = "%s-%s" % (time.strftime("%Y%m%d-%H%M%S", time.localtime()),
                         secrets.token_hex(4))
        d = req_dir(cfg, rid)
        os.makedirs(d, mode=0o700)
        payload = os.path.join(d, "payload.sh")
        with open(payload, "wb") as fh:
            fh.write(raw)
        os.chmod(payload, 0o600)

        token = secrets.token_urlsafe(32)
        meta = {
            "id": rid,
            "created": now(),
            "expires": now() + int(cfg["ttl"]),
            "sha256": sha256_file(payload),
            "desc": (req.get("desc") or "").strip()[:400] or "(no description)",
            "agent": (req.get("name") or "unknown")[:60],
            "submitter": self.identify(uid),
            "token_sha256": hashlib.sha256(token.encode()).hexdigest(),
            "state": "pending",
        }
        write_meta(cfg, rid, meta)
        audit(cfg, "submit", id=rid, uid=uid, agent=meta["agent"],
              sha256=meta["sha256"], desc=meta["desc"])
        try:
            notify(cfg, rid, meta, token)
        except Exception as exc:                      # noqa: BLE001
            meta["state"] = "cancelled"
            meta["error"] = f"notification failed: {exc}"
            write_meta(cfg, rid, meta)
            return {"ok": False, "error": meta["error"], "id": rid}
        # NOTE: the token is deliberately absent from this response.
        return {"ok": True, "id": rid, "sha256": meta["sha256"],
                "expires": meta["expires"],
                "note": "approval request sent to the human's channel; "
                        "poll with: rootgate wait <id>"}

    def op_decide(self, cfg, req, uid, approve):
        rid = req.get("id", "")
        meta = read_meta(cfg, rid)
        if not meta:
            return {"ok": False, "error": "no such request"}
        if meta["state"] != "pending":
            return {"ok": False, "error": f"request is {meta['state']}"}
        if now() > meta["expires"]:
            meta["state"] = "expired"
            write_meta(cfg, rid, meta)
            return {"ok": False, "error": "request expired"}

        # two ways to be the human: hold the token, or be root on this machine
        got = req.get("token") or ""
        token_ok = bool(got) and hmac.compare_digest(
            hashlib.sha256(got.encode()).hexdigest(), meta["token_sha256"])
        if not token_ok and uid != 0:
            audit(cfg, "decision_rejected", id=rid, uid=uid)
            return {"ok": False, "error": "not authorised: bad token and not root"}

        meta["state"] = "approved" if approve else "denied"
        meta["decided_by"] = "root" if (uid == 0 and not token_ok) else "token"
        meta["decided"] = now()
        write_meta(cfg, rid, meta)
        audit(cfg, "approve" if approve else "deny", id=rid,
              by=meta["decided_by"], uid=uid)
        if approve:
            threading.Thread(target=execute, args=(cfg, rid), daemon=True).start()
        return {"ok": True, "id": rid, "state": meta["state"]}

    def op_list(self, cfg):
        out = []
        for m in self.all_metas(cfg):
            out.append(public_meta(cfg, m))
        out.sort(key=lambda m: m["created"], reverse=True)
        return out[:50]

    def all_metas(self, cfg):
        base = os.path.join(cfg["state"], "requests")
        if not os.path.isdir(base):
            return []
        out = []
        for rid in os.listdir(base):
            m = read_meta(cfg, rid)
            if m:
                out.append(m)
        return out

    def identify(self, uid):
        """Best-effort caller identity; self-declared name is separate."""
        peer_pid = struct.unpack("3i", self.request.getsockopt(
            socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))[0]
        info = {"uid": uid, "pid": peer_pid, "exe": "", "cwd": ""}
        try:
            info["exe"] = os.readlink(f"/proc/{peer_pid}/exe")
        except OSError:
            pass
        try:
            info["cwd"] = os.readlink(f"/proc/{peer_pid}/cwd")
        except OSError:
            pass
        return info


def public_meta(cfg, meta):
    m = dict(meta)
    m.pop("token_sha256", None)          # never leaves the daemon
    m["payload"] = os.path.join(req_dir(cfg, meta["id"]), "payload.sh")
    return m


class Server(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True


# ---------------------------------------------------------------- http page
