class Page(http.server.BaseHTTPRequestHandler):
    """Approval UI.

    The token is carried in the URL *fragment* and sent as a request header, so
    it never appears in a request line: reverse proxies, access logs and browser
    history-recall at the server side cannot record it.
    """
    server_version = "rootgate/" + VERSION

    def log_message(self, *_args):
        pass

    def _send(self, code, body, ctype="text/plain; charset=utf-8"):
        raw = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(raw)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(raw)

    def _json(self, code, obj):
        self._send(code, json.dumps(obj), "application/json")

    def _token_ok(self, meta):
        got = self.headers.get("X-Rootgate-Token", "")
        return bool(got) and hmac.compare_digest(
            hashlib.sha256(got.encode()).hexdigest(), meta.get("token_sha256", ""))

    def do_GET(self):
        cfg = self.server.cfg
        path = self.path.split("?", 1)[0]
        if path in ("/", "/a/") or path.startswith("/a/"):
            return self._send(200, SHELL_PAGE, "text/html; charset=utf-8")
        if path.startswith("/api/r/"):
            rid = path[len("/api/r/"):]
            meta = read_meta(cfg, rid)
            if not meta:
                return self._json(404, {"error": "no such request"})
            if not self._token_ok(meta):
                return self._json(403, {"error": "bad or missing token"})
            if meta["state"] != "pending":
                return self._json(409, {"error": f"request is already {meta['state']}"})
            if now() > meta["expires"]:
                return self._json(410, {"error": "request expired"})
            with open(os.path.join(req_dir(cfg, rid), "payload.sh")) as fh:
                payload = fh.read()
            return self._json(200, {
                "id": rid, "agent": meta["agent"], "desc": meta["desc"],
                "sha256": meta["sha256"], "payload": payload,
                "uid": meta["submitter"]["uid"], "pid": meta["submitter"]["pid"],
                "exe": meta["submitter"]["exe"], "cwd": meta["submitter"]["cwd"],
                "expires_in": max(0, meta["expires"] - now()),
            })
        return self._send(404, "not found")

    def do_POST(self):
        cfg = self.server.cfg
        if self.path.split("?", 1)[0] != "/api/decide":
            return self._json(404, {"error": "not found"})
        try:
            n = int(self.headers.get("Content-Length", "0"))
            req = json.loads(self.rfile.read(min(n, 8192)) or b"{}")
        except (ValueError, OSError):
            return self._json(400, {"error": "bad body"})
        rid = req.get("id", "")
        token = req.get("token", "")
        decision = req.get("decision", "")
        if decision not in ("approve", "deny"):
            return self._json(400, {"error": "decision must be approve or deny"})
        meta = read_meta(cfg, rid)
        if not meta:
            return self._json(404, {"error": "no such request"})
        if not hmac.compare_digest(hashlib.sha256(token.encode()).hexdigest(),
                                   meta.get("token_sha256", "")):
            audit(cfg, "decision_rejected", id=rid, by="page")
            return self._json(403, {"error": "bad token"})
        if not approve_or_deny(cfg, rid, token, approve=(decision == "approve")):
            return self._json(409, {"error": "could not apply (expired or already decided)"})
        return self._json(200, {"ok": True, "state": decision})


def approve_or_deny(cfg, rid, token, approve):
    meta = read_meta(cfg, rid)
    if not meta or meta["state"] != "pending":
        return False
    if now() > meta["expires"]:
        meta["state"] = "expired"
        write_meta(cfg, rid, meta)
        return False
    if not hmac.compare_digest(hashlib.sha256(token.encode()).hexdigest(),
                               meta.get("token_sha256", "")):
        return False
    meta["state"] = "approved" if approve else "denied"
    meta["decided_by"] = "token"
    meta["decided"] = now()
    write_meta(cfg, rid, meta)
    audit(cfg, "approve" if approve else "deny", id=rid, by="token")
    if approve:
        threading.Thread(target=execute, args=(cfg, rid), daemon=True).start()
    return True


# ---------------------------------------------------------------- commands
def call(cfg, req, timeout=30):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    s.connect(cfg["socket"])
    s.sendall((json.dumps(req) + "\n").encode())
    buf = b""
    while not buf.endswith(b"\n"):
        chunk = s.recv(65536)
        if not chunk:
            break
        buf += chunk
    s.close()
    return json.loads(buf or b"{}")


def cmd_serve(args, cfg):
    for d in (cfg["state"], os.path.join(cfg["state"], "requests"),
              os.path.dirname(cfg["socket"]), os.path.dirname(cfg["log"])):
        os.makedirs(d, exist_ok=True)
    if os.path.exists(cfg["socket"]):
        os.unlink(cfg["socket"])
    # The socket's own mode is not enough: the directory has to be traversable by
    # the users who are allowed to ask. systemd's RuntimeDirectory default (0750)
    # silently blocks every non-root client.
    os.chmod(os.path.dirname(cfg["socket"]), 0o755)
    srv = Server(cfg["socket"], Handler)
    srv.cfg = cfg
    # Submitting is unprivileged by design; approving is what needs a token or
    # root. A 0660 socket owned by root locks out every agent running as the
    # login user, which is the whole point of the tool.
    os.chmod(cfg["socket"], int(cfg["socket_mode"], 8))
    if cfg["notify"] == "file" and not cfg["notify_file"]:
        raise SystemExit("notify=file needs notify_file")
    httpd = http.server.ThreadingHTTPServer(("127.0.0.1", int(cfg["http_port"])), Page)
    httpd.cfg = cfg
    threading.Thread(target=httpd.serve_forever, daemon=True).start()
    print(f"rootgate {VERSION}: socket {cfg['socket']}, page 127.0.0.1:{cfg['http_port']}, "
          f"notify={cfg['notify']}, euid={os.geteuid()}", flush=True)
    try:
        srv.serve_forever()
    finally:
        srv.server_close()
        if os.path.exists(cfg["socket"]):
            os.unlink(cfg["socket"])


def cmd_submit(args, cfg):
    raw = sys.stdin.buffer.read() if args.file == "-" else open(args.file, "rb").read()
    resp = call(cfg, {"op": "submit", "script": base64.b64encode(raw).decode(),
                      "desc": args.desc, "name": args.name})
    if not resp.get("ok"):
        print("error:", resp.get("error"), file=sys.stderr)
        return 1
    print(f"submitted {resp['id']}")
    print(f"sha256    {resp['sha256']}")
    print(f"expires   {time.strftime('%H:%M:%S', time.localtime(resp['expires']))}")
    print("the approval request went to the human's channel; wait with:")
    print(f"  rootgate wait {resp['id']}")
    return 0


def cmd_status(args, cfg):
    resp = call(cfg, {"op": "status", "id": args.id})
    if not resp.get("ok"):
        print("error:", resp.get("error"), file=sys.stderr)
        return 1
    m = resp["meta"]
    for k in ("id", "state", "exit_code", "desc", "agent", "sha256", "created", "expires"):
        if k in m:
            print(f"{k:10} {m[k]}")
    return 0


def cmd_wait(args, cfg):
    resp = call(cfg, {"op": "wait", "id": args.id, "timeout": args.timeout}, timeout=args.timeout + 10)
    if not resp.get("ok"):
        print("error:", resp.get("error"), file=sys.stderr)
        return 1
    m = resp["meta"]
    print(f"{m['id']}: {m['state']}" + (f" rc={m.get('exit_code')}" if "exit_code" in m else ""))
    if args.verbose or m["state"] in ("done", "failed"):
        log = call(cfg, {"op": "log", "id": args.id}).get("log", "")
        if log:
            print("--- log ---")
            print(log)
    return 0 if m["state"] == "done" else 1


def cmd_list(args, cfg):
    resp = call(cfg, {"op": "list"})
    for m in resp.get("requests", []):
        rc = f" rc={m['exit_code']}" if "exit_code" in m else ""
        print(f"{m['id']}  {m['state']:9}{rc:8} {m['agent']:14} {m['desc'][:60]}")
    return 0


def cmd_approve(args, cfg):
    # Local root approval: root presence is the human factor. Show the payload,
    # require the operator to echo the hash prefix, then decide without a token.
    if os.geteuid() != 0:
        print("rootgate approve must run as root (sudo rootgate approve <id>)\n"
              "otherwise use the link sent to the human's channel.", file=sys.stderr)
        return 1
    resp = call(cfg, {"op": "status", "id": args.id})
    if not resp.get("ok"):
        print("error:", resp.get("error"), file=sys.stderr)
        return 1
    m = resp["meta"]
    with open(m["payload"]) as fh:
        payload = fh.read()
    print(f"id      {m['id']}\nfrom    {m['agent']} (uid {m['submitter']['uid']})\n"
          f"what    {m['desc']}\nsha256  {m['sha256']}\n")
    print("--- payload ---")
    print(payload)
    print("---------------")
    prefix = m["sha256"][:8]
    if args.yes:
        print("approving without confirmation (--yes)")
    else:
        try:
            typed = input(f"type {prefix} to approve this exact payload: ").strip()
        except EOFError:
            return 1
        if typed != prefix:
            print("not approved", file=sys.stderr)
            return 1
    out = call(cfg, {"op": "approve", "id": args.id})
    print(out.get("state") if out.get("ok") else out.get("error"))
    return 0 if out.get("ok") else 1


def cmd_deny(args, cfg):
    out = call(cfg, {"op": "deny", "id": args.id})
    print(out.get("state") if out.get("ok") else out.get("error"))
    return 0 if out.get("ok") else 1


def cmd_log(args, cfg):
    print(call(cfg, {"op": "log", "id": args.id}).get("log", ""), end="")
    return 0


def main(argv=None):
    cfg = load_config()
    p = argparse.ArgumentParser(prog="rootgate", description="agent-agnostic privileged action broker")
    p.add_argument("--socket")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("serve", help="run the daemon")
    s.set_defaults(fn=cmd_serve)

    s = sub.add_parser("submit", help="submit a payload for approval")
    s.add_argument("file", help="script to run as root, or - for stdin")
    s.add_argument("--desc", required=True, help="one line: what this does")
    s.add_argument("--name", default=os.environ.get("ROOTGATE_AGENT", "unknown"),
                   help="who is asking (informational, shown to the human)")
    s.set_defaults(fn=cmd_submit)

    s = sub.add_parser("status", help="show one request")
    s.add_argument("id")
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("wait", help="block until a request finishes")
    s.add_argument("id")
    s.add_argument("--timeout", type=int, default=180)
    s.add_argument("-v", "--verbose", action="store_true")
    s.set_defaults(fn=cmd_wait)

    s = sub.add_parser("log", help="print the request's log")
    s.add_argument("id")
    s.set_defaults(fn=cmd_log)

    s = sub.add_parser("list", help="recent requests")
    s.set_defaults(fn=cmd_list)

    s = sub.add_parser("approve", help="approve locally (root only)")
    s.add_argument("id")
    s.add_argument("--yes", action="store_true")
    s.set_defaults(fn=cmd_approve)

    s = sub.add_parser("deny", help="deny a pending request")
    s.add_argument("id")
    s.set_defaults(fn=cmd_deny)

    args = p.parse_args(argv)
    if args.socket:
        cfg["socket"] = args.socket
    return args.fn(args, cfg)


if __name__ == "__main__":
    sys.exit(main())
